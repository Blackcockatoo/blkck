{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "python3 scripts/prepare-i-ran-lego.py",
  "outputDirectory": ".",
  "rewrites": [
    {
      "source": "/auralia",
      "destination": "/auralia/index.html"
    }
  ],
  "headers": [
    {
      "source": "/auralia/edition-01/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
